# ihomy 外挂配置模板(复制为 external.yml 填真实值;external.yml 已入 .gitignore,严禁提交)
#
# 用法:
#   1. 复制本模板为 external.yml(可放任意路径,惯例:开发 D:\WorkSpace\ihomy\config\external.yml / 生产 /opt/ihomy/config/external.yml)
#   2. 填入真实值
#   3. 设环境变量 IHOMY_CONFIG_PATH 指向该文件(start-all.ps1 / systemd unit 已自动设置)
# 加载机制:ExternalConfigLoader(EnvironmentPostProcessor)启动早期加载,优先级最高,覆盖 application.yml
# 敏感值支持 ENC(...) AES-GCM 加密(盐值 sys_parameter 表 aes-salt,生成用 OPS 接口 /api/ops/crypto/encrypt)

# === 数据库(必填:application.yml 基线留空,缺失则启动连库失败)===
spring:
  datasource:
    password: CHANGE_ME_DB_PASSWORD
  data:
    redis:
      password: CHANGE_ME_REDIS_PASSWORD  # 必填:Redis 已要求密码(--requirepass),与容器/redis-server 的密码同值
  # === 密码找回邮件(SMTP,可选)===
  # 不配置(整段保持注释)时「忘记密码」不可用:用户会看到「暂时无法发送邮件,请联系管理员重置密码」。
  # 启用时取消下方注释并填真实值;password 支持 ENC(...) 加密。
  # mail:
  #   host: smtp.example.com
  #   port: 465
  #   username: no-reply@example.com
  #   password: CHANGE_ME_SMTP_PASSWORD
  #   default-encoding: UTF-8
  #   properties:
  #     mail.smtp.auth: true
  #     mail.smtp.ssl.enable: true

# === JWT 签名密钥(必填:缺失则后端启动即失败;≥32 字符随机串,泄露等于全部 token 可伪造)===
jwt:
  secret: CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# === 文件上传目录(按环境改路径)===
file:
  upload-dir: /opt/ihomy/uploads
  url-prefix: /files

# === 日志目录(自动分 access/server/thirdparty 三子目录)===
logging:
  file:
    path: /opt/ihomy/logs
  level:
    mybatis.sql: warn            # SQL 语句+入参日志级别(默认 warn 静默,防敏感数据入日志);排查时改 debug

# === 应用差异化配置 ===
app:
  captcha-fixed-code:          # 开发可填固定验证码方便测试;生产必须留空(随机验证码)
  cors-allowed-origins: http://localhost:5173,http://127.0.0.1:5173   # 跨域白名单(逗号分隔);生产留空用基线 https://ihomy.top,开发填本地前端地址
  weather-api-host:            # 和风天气 JWT 凭证(可全留空:优先从 DB sys_weather_credential 读 status=1 记录)
  weather-project-id:
  weather-key-id:
  weather-private-key:         # Ed25519 私钥 PEM;不入 git,推荐只配 DB 并用 ENC(...) 加密
  # 密码找回邮件:发件人(空=取 spring.mail.username);重置链接基址(指向前端重置页)
  mail:
    from:                      # 如 no-reply@example.com
    reset-url-base:            # 如 https://ihomy.top/reset-password(留空用 application.yml 基线)
  # AI 大模型配置已按家庭(模型池 sys_family_ai_model + 功能绑定 sys_family_ai_feature),在应用内「设置-家庭 AI 配置」维护,不再走全局 yml(V9.48)
  # 同类异常聚合预警(可选覆盖,基线见 application.yml):
  #   enabled/levels/window-seconds/threshold/cooldown-seconds/max-fingerprints/exclude-loggers/retention-days/mail-enabled
  #   收件人取系统级 OPS 角色的邮箱;未配 spring.mail.host 时不发信,只在运维页「异常预警」展示
  # log-alert:
  #   threshold: 10

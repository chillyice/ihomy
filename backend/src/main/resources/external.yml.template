# ihomy 外挂配置模板(复制为 external.yml 填真实值;external.yml 已入 .gitignore,严禁提交)
#
# 用法:
#   1. 复制本模板为 external.yml(可放任意路径,惯例:开发 D:\WorkSpace\ihomy\config\external.yml / 生产 /opt/ihomy/config/external.yml)
#   2. 填入真实值
#   3. 设环境变量 IHOMY_CONFIG_PATH 指向该文件(start-all.ps1 / systemd unit 已自动设置)
# 加载机制:ExternalConfigLoader(EnvironmentPostProcessor)启动早期加载,优先级最高,覆盖 application.yml
# 敏感值支持 ENC(...) AES-GCM 加密(盐值 sys_parameter 表 aes-salt,生成用 OPS 接口 /api/ops/crypto/encrypt)

# === 数据库(必填:application.yml 基线留空,缺失则启动连库失败)===
spring:
  datasource:
    password: CHANGE_ME_DB_PASSWORD
  data:
    redis:
      password:                # 无密码留空

# === JWT 签名密钥(必填:缺失则后端启动即失败;≥32 字符随机串,泄露等于全部 token 可伪造)===
jwt:
  secret: CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# === 文件上传目录(按环境改路径)===
file:
  upload-dir: /opt/ihomy/uploads
  url-prefix: /files

# === 日志目录(自动分 access/server/thirdparty 三子目录)===
logging:
  file:
    path: /opt/ihomy/logs

# === 应用差异化配置 ===
app:
  captcha-fixed-code:          # 开发可填固定验证码方便测试;生产必须留空(随机验证码)
  weather-api-host:            # 和风天气 JWT 凭证(可全留空:优先从 DB sys_weather_credential 读 status=1 记录)
  weather-project-id:
  weather-key-id:
  weather-private-key:         # Ed25519 私钥 PEM;不入 git,推荐只配 DB 并用 ENC(...) 加密
  # AI 大模型统一接入(OpenAI 兼容):物品定位 AI 找物/放物及后续 AI 功能共用,三项全配置才启用
  # 图片生成/语音识别:对应 model 配置后启用,base-url/api-key 留空复用上面主配置(走同一代理)
  # ai:
  #   base-url: https://api.deepseek.com   # OpenAI 兼容服务地址(不含 /chat/completions)
  #   api-key: CHANGE_ME_AI_API_KEY        # 支持 ENC(...) 加密(GET /api/ops/crypto/encrypt 生成)
  #   model: deepseek-chat
  #   timeout-ms: 30000
  #   image-model: doubao-seedream-4-0     # 图片生成模型(豆包 Seedream,走 /images/generations)
  #   image-base-url:                      # 留空复用 base-url
  #   image-api-key:                       # 留空复用 api-key
  #   asr-model: SenseVoice                # 语音识别模型(走 /audio/transcriptions)
  #   asr-base-url:                        # 留空复用 base-url
  #   asr-api-key:                         # 留空复用 api-key

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ihomy.mapper.FamilyLoanRepayMapper">

    <!-- 已记账期次:一行一个 (loan_id, period),列表页在内存里按 loanId 归组 -->
    <select id="selectBookedPeriods" resultType="com.ihomy.entity.FamilyLoanRepay">
        SELECT loan_id, period
          FROM family_loan_repay
         WHERE family_id = #{familyId}
         ORDER BY loan_id, period
    </select>
</mapper>

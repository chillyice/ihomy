# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

# --- OS specific support --------------------------------------

case "`uname`" in
  CYGWIN*) cygwin=true ;;
  MINGW*) msys=true ;;
  Darwin*) darwin=true ;;
esac

# --- resolve the base directory -------------------------------

# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
MAVEN_PROJECTBASEDIR="`pwd`"
cd "$SAVED" >/dev/null

# --- MAVEN_OPTS -----------------------------------------------

if [ -z "$MAVEN_OPTS" ]; then
  MAVEN_OPTS="-Xmx512m"
fi

# --- JVM detection --------------------------------------------

if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    # IBM's JDK on AIX uses strange locations for the executables
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
  if [ ! -x "$JAVACMD" ] ; then
    echo "Error: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
    echo "Please set the JAVA_HOME variable in your environment to match the location of your Java installation." >&2
    exit 1
  fi
else
  JAVACMD="`which java`"
  if [ ! -x "$JAVACMD" ] ; then
    echo "Error: JAVA_HOME not found in your environment." >&2
    echo "Please set the JAVA_HOME variable in your environment to match the location of your Java installation." >&2
    exit 1
  fi
fi

# --- classpath ------------------------------------------------

# Provide a "standardized" way to retrieve the CLI args that will
# work with both Windows and non-Windows executions.
MAVEN_CMD_LINE_ARGS="$@"
export MAVEN_CMD_LINE_ARGS

CLASSWORLDS_LAUNCHER=org.codehaus.plexus.classworlds.launcher.Launcher

# --- find maven-wrapper.jar -----------------------------------

MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$MAVEN_PROJECTBASEDIR"}
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# If not found, try download (PowerShell fallback removed for POSIX simplicity;
# jar should already be present in .mvn/wrapper/)
if [ ! -e "$WRAPPER_JAR" ]; then
  echo "Error: Maven wrapper jar not found at: $WRAPPER_JAR" >&2
  echo "Please ensure .mvn/wrapper/maven-wrapper.jar exists." >&2
  exit 1
fi

# --- exec -----------------------------------------------------

exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <!-- DayNight:窗口背景跟系统深浅色走。targetSdk 36 强制 edge-to-edge 后,状态栏露出的
         底色=窗口背景,亮色主题会在深色页面下衬出白条(配合 IhomyWindowBars 由前端刷页面底色) -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 启动页与主任务交接时不要第二个转场:两个窗口底色同为 logo_splash_canvas,
             无动画才看不出换了窗口(有动画会被 ROM 画成任务切换)。这是 postSplashScreenTheme,
             窗口进场动画按它解析,所以除了 IhomyMain 这里也要写一份。 -->
        <item name="android:windowAnimationStyle">@style/IhomyNoWindowAnimation</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>

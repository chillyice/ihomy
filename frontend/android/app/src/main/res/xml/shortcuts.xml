<?xml version="1.0" encoding="utf-8"?>
<!-- 长按桌面图标弹出的快捷方式:静态声明,点击走 ihomy:// 深链(MainActivity 的 VIEW filter 承接,
     deeplink.js 统一识别路由)。短标签按 Android 建议 ≤10 字,长标签补充说明。
     属性名口径:shortcutId / shortcutShortLabel / shortcutLongLabel / enabled / icon。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_schedule"
        android:shortcutId="schedule"
        android:shortcutShortLabel="@string/shortcut_schedule"
        android:shortcutLongLabel="@string/shortcut_schedule_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://plan?tab=today"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_book"
        android:shortcutId="book"
        android:shortcutShortLabel="@string/shortcut_book"
        android:shortcutLongLabel="@string/shortcut_book_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://book"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutId="chat"
        android:shortcutShortLabel="@string/shortcut_chat"
        android:shortcutLongLabel="@string/shortcut_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://chat"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_album"
        android:shortcutId="album"
        android:shortcutShortLabel="@string/shortcut_album"
        android:shortcutLongLabel="@string/shortcut_album_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://album"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <!-- 第二批:一次性动作入口。顺序排在老 4 条之后,launcher 显示条数有限时先保证老入口不丢。
         data 里的 ?new=1 / ?voice=1 / ?search=1 由前端消费并自行清参(deeplink.js / Book.vue / Schedule.vue)。 -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_book"
        android:shortcutId="book-new"
        android:shortcutShortLabel="@string/shortcut_book_new"
        android:shortcutLongLabel="@string/shortcut_book_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://book?new=1"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_schedule"
        android:shortcutId="reminder-new"
        android:shortcutShortLabel="@string/shortcut_reminder_new"
        android:shortcutLongLabel="@string/shortcut_reminder_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://plan?new=1"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutId="book-voice"
        android:shortcutShortLabel="@string/shortcut_book_voice"
        android:shortcutLongLabel="@string/shortcut_book_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://book?voice=1"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="ihomy://home?search=1"
            android:targetClass="top.ihomy.app.MainActivity"
            android:targetPackage="top.ihomy.app" />
    </shortcut>

</shortcuts>

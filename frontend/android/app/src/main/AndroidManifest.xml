<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性:不声明就看不到系统语音识别服务(SpeechRecognizer 会误报不可用) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup=false:令牌密文在 EncryptedSharedPreferences,其密钥不参与备份,
         换机恢复后解不开等于死数据;关闭云备份也避免密文随 adb backup 落地。
         usesCleartextTraffic=false:接口与文件全部 https,壳内不需要明文流量。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标快捷方式:今日日程 / 记账本 / 家庭聊天 / 相册(静态声明,走 ihomy:// 深链) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 桌面卡片深链:ihomy://plan?date=... / ihomy://anniversary 等,进入壳内由 deeplink.js 统一路由 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ihomy" />
            </intent-filter>

            <!-- 系统分享收件:微信/浏览器分享文字链接、相册分享图片(单张/多张)→ 站内「分享到家庭」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <!-- 桌面卡片 ×3:今日概览 / 今日提醒 / 纪念日倒计时(RemoteViews 直写,数据见 widget/ 目录) -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_today" />
        </receiver>

        <receiver
            android:name=".widget.ReminderWidgetProvider"
            android:exported="false"
            android:label="@string/widget_reminder_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_reminder" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/widget_countdown_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_countdown" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 下拉栏快速设置磁贴:记账本 / 今日日程(点一下直接进站内页面,无开关语义) -->
        <service
            android:name=".tile.BookTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_book"
            android:label="@string/tile_book_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.PlanTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_schedule"
            android:label="@string/tile_plan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 保险箱进页前的本机指纹/人脸校验(系统 BiometricPrompt,不读生物特征数据) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 语音记账:识别时说一句话(录音只交给系统识别服务,不落盘、不上传自家后端) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 系统日历单向导出(兜底提醒):只写本机专属「ihomy」日历,授权在设置页里按需申请 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 应用内更新:允许 ihomy 调起系统安装器装自己下载好的新版本(仍需用户在系统设置里单独授权一次) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>

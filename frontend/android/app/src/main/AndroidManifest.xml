<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性:不声明就看不到系统语音识别服务(SpeechRecognizer 会误报不可用) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup=false:令牌密文在 EncryptedSharedPreferences,其密钥不参与备份,
         换机恢复后解不开等于死数据;关闭云备份也避免密文随 adb backup 落地。
         usesCleartextTraffic=false:接口与文件全部 https,壳内不需要明文流量。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标快捷方式:今日日程 / 记账本 / 家庭聊天 / 相册(静态声明,走 ihomy:// 深链) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 桌面卡片深链:ihomy://plan?date=... / ihomy://anniversary 等,进入壳内由 deeplink.js 统一路由 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ihomy" />
            </intent-filter>

            <!-- 系统分享收件:微信/浏览器分享文字链接、相册分享图片(单张/多张)、
                 文件管理器分享 PDF/视频 → 站内「分享到家庭」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- 接收文件:PDF / 视频(单发);PDF 多发。只列明确类型,不用 */* 抢分享面板 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- 用 ihomy 打开:图片 / PDF(content:// 与 file://)。
                 同一 intent-filter 内的多个 data 是属性合并(scheme ∈ {content,file} 且 mime ∈ {image/*,pdf}) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

        </activity>

        <!-- 桌面卡片 ×4:今日概览 / 今日提醒 / 纪念日倒计时 / 记账本月(RemoteViews 直写,数据见 widget/ 目录) -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_today" />
        </receiver>

        <receiver
            android:name=".widget.ReminderWidgetProvider"
            android:exported="false"
            android:label="@string/widget_reminder_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_reminder" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/widget_countdown_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_countdown" />
        </receiver>

        <receiver
            android:name=".widget.BookWidgetProvider"
            android:exported="false"
            android:label="@string/widget_book_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_book" />
        </receiver>

        <!-- 卡片勾选动作:提醒卡圆圈 → 广播 → Worker 勾选并整轮刷新(exported=false,仅本包) -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="top.ihomy.app.action.WIDGET_TOGGLE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 应用内更新:系统下载器下完的包 → 设备所有者静默装 / 其余人一条「点此安装」通知 -->
        <receiver
            android:name=".updater.DownloadDoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
                <action android:name="top.ihomy.app.action.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- 设备所有者入口:用户用 adb 执行 dpm set-device-owner 后才生效(换成真静默安装) -->
        <receiver
            android:name=".updater.IhomyDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 后台消息提醒:常驻前台服务,App 在后台/锁屏时每 30 秒对一次未读并提醒。
             remoteMessaging 类型(Android 14+ 必须在 startForeground 时声明);
             不用 stopWithTask:从最近任务划掉后仍继续提醒,直到设置里关闭或系统清理。 -->
        <service
            android:name=".live.LiveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- 下拉栏快速设置磁贴:记账本 / 今日日程(点一下直接进站内页面,无开关语义) -->
        <service
            android:name=".tile.BookTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_book"
            android:label="@string/tile_book_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.PlanTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_schedule"
            android:label="@string/tile_plan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台消息提醒:前台服务 + Android 14 的 remoteMessaging 类型 + 通知运行时权限(13+)。
         通知权限在设置页打开「后台消息提醒」时用 LocalNotifications 主动申请。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 触觉反馈(normal 权限,不弹窗):勾选/长按/拖拽等语义动作的轻震 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 保险箱进页前的本机指纹/人脸校验(系统 BiometricPrompt,不读生物特征数据) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 语音记账 + 语音/视频通话:录音(RECORD_AUDIO 本机展示权限,同时供 WebView getUserMedia 用) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音/视频通话:页面里 getUserMedia 要拿摄像头/麦克风,WebView 会按下面的声明向系统申请运行时权限
         (Capacitor 的 WebChromeClient.onPermissionRequest 会同时要 CAMERA / RECORD_AUDIO / MODIFY_AUDIO_SETTINGS,
         少声明一条整组都会被拒,页面侧表现为「权限被拒绝」——2026-11-11 修) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 声明 CAMERA 会让商店/系统把本应用判为「需要相机」,显式 required=false 免得无相机设备被过滤 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- 系统日历单向导出(兜底提醒):只写本机专属「ihomy」日历,授权在设置页里按需申请 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 应用内更新:允许 ihomy 调起系统安装器装自己下载好的新版本(仍需用户在系统设置里单独授权一次) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 相册自动备份:只读手机照片(Android 13+ 用细分权限,12 及以下仍走存储权限) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>

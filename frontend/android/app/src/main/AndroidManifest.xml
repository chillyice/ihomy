<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性:不声明就看不到系统语音识别服务(SpeechRecognizer 会误报不可用) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 系统相机:Android 11+ 不声明 ACTION_IMAGE_CAPTURE 的包可见性,
             resolveActivity 在部分机型(华为/鸿蒙)返回 null,拍照键误报「没有可用相机」 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Android 13 及以下健康连接是独立 APK:不声明包可见性会误判「本机不可用」 -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- HMS Health Kit(华为运动健康):AGC 配好应用后把 <string name="hms_health_appid"> 里的
         appid 换成 AGC 应用的数字 id;没配置时华为健康链自动视为不可用,回落 Health Connect -->
    <meta-data
        android:name="com.huawei.hms.client.appid"
        android:value="@string/hms_health_appid" />

    <!-- allowBackup=false:令牌密文在 EncryptedSharedPreferences,其密钥不参与备份,
         换机恢复后解不开等于死数据;关闭云备份也避免密文随 adb backup 落地。
         usesCleartextTraffic=false:接口与文件全部 https,壳内不需要明文流量。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/logo_window_dark"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_window_dark"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/IhomyLauncher"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true">

            <!-- 桌面卡片深链:ihomy://plan?date=... / ihomy://anniversary 等,进入壳内由 deeplink.js 统一路由 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ihomy" />
            </intent-filter>

            <!-- 系统分享收件:微信/浏览器分享文字链接、相册分享图片(单张/多张)、
                 文件管理器分享 PDF/视频 → 站内「分享到家庭」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- 接收文件:PDF / 视频(单发);PDF 多发。只列明确类型,不用 */* 抢分享面板 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- 用 ihomy 打开:图片 / PDF(content:// 与 file://)。
                 同一 intent-filter 内的多个 data 是属性合并(scheme ∈ {content,file} 且 mime ∈ {image/*,pdf}) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

        </activity>

        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="top.ihomy.app.launcher"
            android:theme="@style/IhomyLauncher" />

        <!-- 桌面入口只负责唤起独立的主任务，切图标不会关闭用户正在操作的页面。 -->
        <activity-alias
            android:name=".WindowDarkLauncher"
            android:targetActivity=".launcher.LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/logo_window_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".WindowLightLauncher"
            android:targetActivity=".launcher.LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_window_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".LeafDarkLauncher"
            android:targetActivity=".launcher.LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_leaf_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".LeafLightLauncher"
            android:targetActivity=".launcher.LauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_leaf_light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 健康连接授权弹窗里的「为什么需要」说明页(系统要求:声明 ACTION_SHOW_PERMISSIONS_RATIONALE) -->
        <activity
            android:name=".health.HealthPermissionRationaleActivity"
            android:exported="true"
            android:label="@string/health_rationale_title"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- 桌面卡片 ×4:今日概览 / 今日提醒 / 纪念日倒计时 / 记账本月(RemoteViews 直写,数据见 widget/ 目录) -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_today" />
        </receiver>

        <receiver
            android:name=".widget.ReminderWidgetProvider"
            android:exported="false"
            android:label="@string/widget_reminder_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_reminder" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/widget_countdown_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_countdown" />
        </receiver>

        <receiver
            android:name=".widget.BookWidgetProvider"
            android:exported="false"
            android:label="@string/widget_book_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_book" />
        </receiver>

        <!-- 卡片勾选动作:提醒卡圆圈 → 广播 → Worker 勾选并整轮刷新(exported=false,仅本包) -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="top.ihomy.app.action.WIDGET_TOGGLE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 应用内更新:系统下载器下完的包 → 设备所有者静默装 / 其余人一条「点此安装」通知 -->
        <receiver
            android:name=".updater.DownloadDoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
                <action android:name="top.ihomy.app.action.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- 设备所有者入口:用户用 adb 执行 dpm set-device-owner 后才生效(换成真静默安装) -->
        <receiver
            android:name=".updater.IhomyDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 后台消息提醒:常驻前台服务,App 在后台/锁屏时每 30 秒对一次未读并提醒。
             remoteMessaging 类型(Android 14+ 必须在 startForeground 时声明);
             不用 stopWithTask:从最近任务划掉后仍继续提醒,直到设置里关闭或系统清理。 -->
        <service
            android:name=".live.LiveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- 下拉栏快速设置磁贴:记账本 / 今日日程(点一下直接进站内页面,无开关语义) -->
        <service
            android:name=".tile.BookTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_book"
            android:label="@string/tile_book_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.PlanTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_schedule"
            android:label="@string/tile_plan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台消息提醒:前台服务 + Android 14 的 remoteMessaging 类型 + 通知运行时权限(13+)。
         通知权限在设置页打开「后台消息提醒」时用 LocalNotifications 主动申请。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 触觉反馈(normal 权限,不弹窗):勾选/长按/拖拽等语义动作的轻震 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 保险箱进页前的本机指纹/人脸校验(系统 BiometricPrompt,不读生物特征数据) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 语音记账 + 语音/视频通话:录音(RECORD_AUDIO 本机展示权限,同时供 WebView getUserMedia 用) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音/视频通话:页面里 getUserMedia 要拿摄像头/麦克风,WebView 会按下面的声明向系统申请运行时权限
         (Capacitor 的 WebChromeClient.onPermissionRequest 会同时要 CAMERA / RECORD_AUDIO / MODIFY_AUDIO_SETTINGS,
         少声明一条整组都会被拒,页面侧表现为「权限被拒绝」——2026-11-11 修) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 声明 CAMERA 会让商店/系统把本应用判为「需要相机」,显式 required=false 免得无相机设备被过滤 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- 系统日历单向导出(兜底提醒):只写本机专属「ihomy」日历,授权在设置页里按需申请 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 应用内更新:允许 ihomy 调起系统安装器装自己下载好的新版本(仍需用户在系统设置里单独授权一次) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 相册自动备份:只读手机照片(Android 13+ 用细分权限,12 及以下仍走存储权限;14 的部分授权单独声明) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 健康数据(Health Connect):只读,按四组在设置页里按需申请;记录类型 ↔ 权限码由 connect-client 版本生成,
         升级库时以 HealthPermission.getReadPermission(XXX::class) 为准。 -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_FLIGHTS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <!-- 每日后台同步(WorkManager)读健康数据;Android 15+ 需要这条,旧系统忽略 -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
</manifest>

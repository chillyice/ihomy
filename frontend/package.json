{
  "name": "ihomy-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copy-ruffle.mjs && node scripts/copy-emulatorjs.mjs && vite",
    "build": "node scripts/copy-ruffle.mjs && node scripts/copy-emulatorjs.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tools:export": "node ../scripts/export-tools.mjs",
    "tools:export:check": "node ../scripts/export-tools.mjs --check",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@emulatorjs/emulatorjs": "^4.2.3",
    "@ruffle-rs/ruffle": "0.7.1",
    "axios": "1.21.0",
    "dompurify": "^3.4.17",
    "element-plus": "2.14.7",
    "epubjs": "^0.3.93",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "hls.js": "1.7.4",
    "js-yaml": "5.5.0",
    "marked": "18.1.2",
    "pdfjs-dist": "6.5.438",
    "pinia": "^2.1.7",
    "qweather-icons": "^1.8.0",
    "simple-mind-map": "^0.14.0",
    "smol-toml": "^1.9.1",
    "three": "0.187.0",
    "vue": "3.5.44",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "10.12.0",
    "globals": "^15.15.0",
    "prettier": "3.9.10",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}

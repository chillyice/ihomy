{
  "name": "ihomy-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/copy-ruffle.mjs && node scripts/copy-emulatorjs.mjs && vite",
    "build": "node scripts/copy-ruffle.mjs && node scripts/copy-emulatorjs.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tools:export": "node ../scripts/export-tools.mjs",
    "tools:export:check": "node ../scripts/export-tools.mjs --check",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@emulatorjs/emulatorjs": "^4.2.3",
    "@ruffle-rs/ruffle": "0.7.1",
    "axios": "1.21.0",
    "dompurify": "^3.4.17",
    "element-plus": "2.14.7",
    "epubjs": "^0.3.93",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "hls.js": "1.7.4",
    "js-yaml": "5.5.0",
    "marked": "18.1.2",
    "pdfjs-dist": "6.5.438",
    "pinia": "4.1.0",
    "qweather-icons": "^1.8.0",
    "simple-mind-map": "^0.14.0",
    "smol-toml": "^1.9.1",
    "three": "0.187.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}

# 本地工具/IDE 目录(AI 会话与技能/IDEA 工程文件,不入库)
.zcode/
.agents/
.opencode/
.idea/

# GUI 测试截图(测试产物,不入库)
gui-test-screenshots/

# Python 字节码缓存(py_compile/pytest 生成,不入库)
__pycache__/
*.pyc

# 本地维护文档(含凭证/部署细节,不入库;OneDrive 本地副本是唯一来源)
/Linux部署指导.md
/docs/新人上手指南.md

# 外挂配置真实值(模板 external.yml.template 入库)
external.yml
external.yml.bak

# setup.ps1 生成的本机开发数据(上传文件/日志)
/data/

# 前端本地环境变量(演示账号密码等;frontend/.gitignore 的 *.local 已覆盖,此处双保险)
frontend/.env.local
frontend/.env.development.local

# Ruffle 自托管运行时(由 scripts/copy-ruffle.mjs 从 node_modules 拷贝生成,与 dist 同属构建产物)
frontend/public/ruffle/
# EmulatorJS 运行时(由 scripts/copy-emulatorjs.mjs 从 node_modules 拷贝生成)
frontend/public/emulatorjs/

# 壁纸包 zip(源在 wallpaper-engine/,一条 tar 命令即可重生成;不入库)
/wallpaper-engine.zip

# ============================================================
# ihomy MySQL 调优配置
# 适用:家庭规模(2-20人,低并发),目标控制总内存 < 2GB
# 用途:Docker 挂载到 /etc/mysql/conf.d/ 或本机 MySQL 配置
# 说明:在保留原有端口/字符集/认证插件基础上,压缩内存占用
# ============================================================

[mysqld]
# ---------- 基础设置 ----------
# 时区设置（与容器时区一致）
default-time_zone = '+8:00'
# 设置 6306 端口
port = 6306
# 允许连接失败次数（防止暴力破解）
max_connect_errors = 10
# 字符集
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# 默认存储引擎
default-storage-engine = INNODB
# 认证插件：MySQL 8.4 默认 caching_sha2_password（更安全），不强制用 mysql_native_password
# 应用端 application.yml 已配 allowPublicKeyRetrieval=true，可正常连接 caching_sha2_password 账号
# 若老版可视化工具不支持，需显式启用插件后用：mysql_native_password（见下方注释行）
# mysql_native_password=ON
# authentication_policy = mysql_native_password
# 跳过 DNS 反向解析（关键！避免 ERROR 2013 / system error 104 连接握手超时）
# 禁用后只用 IP 匹配账号（localhost / %），不能用主机名账号
skip-name-resolve = 1

# ---------- 连接数（家庭场景大幅降低，默认 151 太高）----------
# 每个连接约占 256K-1M 内存，家庭 2-20 人并发极低
max_connections = 30
# 宕余连接缓存，省内存
thread_cache_size = 4

# ---------- InnoDB 内存（关键）----------
# InnoDB 缓冲池，缓存数据和索引。家庭数据量小，128M 够用
innodb_buffer_pool_size = 128M
# redo 日志容量（MySQL 8.0.30+ 用此参数，替代被移除的 innodb_log_file_size）
# 旧 64M*2 文件 = 新 128M 总容量
innodb_redo_log_capacity = 128M

# ---------- 表缓存（默认 4000 太高）----------
table_open_cache = 200
table_definition_cache = 200

# ---------- 会话级 buffer（每连接分配，调小省内存）----------
sort_buffer_size = 128K
read_buffer_size = 128K
join_buffer_size = 128K
read_rnd_buffer_size = 128K
binlog_cache_size = 32K

# ---------- 临时表 ----------
tmp_table_size = 16M
max_heap_table_size = 16M

# ---------- MyISAM（几乎不用，保持小值）----------
key_buffer_size = 8M

# ---------- 性能监控关闭（关键！省 80-100MB）----------
# performance_schema 默认开启会预分配大量内存，家庭场景无需
performance_schema = OFF

# ---------- 日志 ----------
# 慢查询日志（家庭场景关闭，避免日志目录不存在导致启动失败；需要时再开启）
slow_query_log = 0
long_query_time = 2

[mysql]
# mysql 客户端默认字符集
default-character-set = utf8mb4

[client]
# 客户端连接端口
port = 6306
default-character-set = utf8mb4
